rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.sign_in_provider == "google.com" &&
        request.auth.token.email == "chevplayz@gmail.com";
    }

    function validString(s, minLen, maxLen) {
      return s is string && s.size() >= minLen && s.size() <= maxLen;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function pollDurationH(data) {
      return data.keys().hasAny(['durationH']) ? data.durationH : 48;
    }

    function safeVotes() {
      return request.auth != null &&
        request.resource.data.votes is list &&
        request.resource.data.votes.size() == resource.data.options.size() &&
        request.resource.data.voters is map &&
        request.resource.data.voters[request.auth.uid] is int &&
        request.resource.data.voters[request.auth.uid] >= 0 &&
        request.resource.data.voters[request.auth.uid] < resource.data.options.size() &&
        (!('voters' in resource.data) ||
         !(request.auth.uid in resource.data.voters));
    }

    function safeUpvotes() {
      return request.resource.data.upvotes is int &&
        request.resource.data.upvotes >= 0 &&
        request.resource.data.upvotes <= 1000000;
    }

    function safeDownvotes() {
      return request.resource.data.downvotes is int &&
        request.resource.data.downvotes >= 0 &&
        request.resource.data.downvotes <= 1000000;
    }

    function safeComments() {
      return (!changedKeys().hasAny(['comments']) ||
              (request.resource.data.comments is map &&
               request.resource.data.comments.size() <= 500));
    }

    function isValidNewPoll(data) {
      return data.question is string &&
        data.question.size() > 0 &&
        data.question.size() <= 120 &&
        data.options is list &&
        data.options.size() >= 2 &&
        data.options.size() <= 7 &&
        data.votes is list &&
        data.votes.size() == data.options.size() &&
        data.author is string &&
        data.author.size() > 0 &&
        data.author.size() <= 30 &&
        data.createdAt is number &&
        data.archived == false &&
        (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 280)) &&
        (!data.keys().hasAny(['category']) ||
          (data.category is string && data.category.size() > 0 && data.category.size() <= 20)) &&
        (!data.keys().hasAny(['durationH']) ||
          (data.durationH is int && data.durationH >= 1 && data.durationH <= 48)) &&
        (!data.keys().hasAny(['upvotes']) || data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 1000000) &&
        (!data.keys().hasAny(['downvotes']) || data.downvotes is int && data.downvotes >= 0 && data.downvotes <= 1000000) &&
        (!data.keys().hasAny(['hot']) || data.hot is bool) &&
        (!data.keys().hasAny(['creatorId']) || (data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 40)) &&
        (!data.keys().hasAny(['creatorUid']) || (data.creatorUid is string && data.creatorUid.size() > 0 && data.creatorUid.size() <= 40)) &&
        (!data.keys().hasAny(['comments']) ||
          (data.comments is map && data.comments.size() <= 500));
    }

    function onlySafeFieldUpdates() {
      return changedKeys().hasOnly([
        'votes', 'voters', 'upvotes', 'downvotes', 'comments'
      ]) &&
        (!changedKeys().hasAny(['votes']) || safeVotes()) &&
        (!changedKeys().hasAny(['upvotes']) || safeUpvotes()) &&
        (!changedKeys().hasAny(['downvotes']) || safeDownvotes()) &&
        (!changedKeys().hasAny(['comments']) || safeComments());
    }

    // Auto-archive: any signed-in user (anonymous included) may flip a poll's
    // archived flag from false to true, but only once the poll is past its
    // lifetime. Nothing else may change in the same write — no vote tampering,
    // no early closing, no un-archiving.
    function isArchiveUpdate() {
      return request.auth != null &&
        changedKeys().hasOnly(['archived']) &&
        resource.data.archived == false &&
        request.resource.data.archived == true &&
        request.time.toMillis() - resource.data.createdAt >
          pollDurationH(resource.data) * 3600 * 1000;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if isValidNewPoll(request.resource.data);
      allow update: if isAdmin() ||
        onlySafeFieldUpdates() ||
        isArchiveUpdate();
      allow delete: if isAdmin() ||
        (request.auth != null &&
         request.auth.uid == resource.data.creatorUid &&
         !resource.data.archived &&
         request.time.toMillis() - resource.data.createdAt <
           pollDurationH(resource.data) * 3600 * 1000);
    }
  }
}
